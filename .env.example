# Copy to .env for local development. Each unit that makes the server read a new
# variable adds it here.

# Matches the Postgres service in docker-compose.yml.
DATABASE_URL=postgres://simmery:simmery@localhost:5432/simmery

# WorkOS AuthKit (KTD3), from the WorkOS dashboard of a staging environment.
# Public sign-up must be disabled there: the server provisions every user
# WorkOS authenticates, so invitations are the only gate (R1).
WORKOS_API_KEY=sk_test_replace_me
WORKOS_CLIENT_ID=client_replace_me
# Seals the session cookie; at least 32 characters (`openssl rand -base64 32`).
WORKOS_COOKIE_PASSWORD=replace-with-at-least-32-random-characters
# The AuthKit domain (Domains in the dashboard), the issuer of MCP access tokens.
# Register PUBLIC_BASE_URL + /mcp as a Resource Indicator there, or tokens carry
# the client ID as audience and /mcp rejects them.
WORKOS_AUTHKIT_DOMAIN=https://replace-me.authkit.app

# The origin the app is served from, without a trailing slash. The AuthKit
# redirect URI is this plus /auth/callback; register it in WorkOS. Cookies
# drop the Secure flag only for http://localhost.
PUBLIC_BASE_URL=http://localhost:3000

# Optional.
# PORT=3000
# Built web app to serve with an SPA fallback (apps/web/dist once U9 lands).
# WEB_ROOT=../web/dist
# LOG_LEVEL=info
