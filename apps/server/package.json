{
  "name": "@simmery/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/app.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "simmery": "./src/app.ts",
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js",
      "default": "./dist/app.js"
    }
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@hono/zod-validator": "0.9.1",
    "@modelcontextprotocol/hono": "2.0.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@simmery/db": "workspace:*",
    "@simmery/domain": "workspace:*",
    "@workos-inc/node": "12.0.0",
    "hono": "4.13.14",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "tslib": "^2.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15"
  },
  "nx": {
    "name": "server",
    "targets": {
      "dev": {
        "continuous": true,
        "command": "tsx watch --conditions=simmery --env-file=../../.env src/main.ts",
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "start": {
        "continuous": true,
        "dependsOn": [
          "build"
        ],
        "command": "node --env-file-if-exists=../../.env dist/main.js",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
