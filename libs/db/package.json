{
  "name": "@simmery/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "simmery": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "simmery": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11"
  },
  "nx": {
    "targets": {
      "db-generate": {
        "command": "drizzle-kit generate",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
